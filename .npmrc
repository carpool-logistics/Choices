message=":bookmark: Version %s"
git-tag-version=true

# Security: never execute dependency lifecycle scripts (preinstall/install/postinstall)
# on install. Without this, any one of the ~1100 transitive packages in
# package-lock.json can run arbitrary code on developer machines and CI runners the
# moment it is installed, which is the primary npm supply-chain compromise path.
# Only Cypress genuinely needs its install script (it downloads the runner binary);
# CI installs that binary explicitly via `npx cypress install`.
ignore-scripts=true
